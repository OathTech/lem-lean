import Init

/- Design witnesses, not a backend implementation. These definitions use no
   runtime seams. See the contract appendix for scope and rebuild commands. -/
namespace FailureMonadContracts

abbrev C := Except String

def CompRel (R : A → B → Prop) (a : A) (m : C B) : Prop :=
  ∀ b, m = .ok b → R a b

def ArrowRel (RA : A → A' → Prop) (RB : B → B' → Prop)
    (f : A → B) (g : A' → C B') : Prop :=
  ∀ a a', RA a a' → CompRel RB (f a) (g a')

theorem pure_related (h : R a b) : CompRel R a (.ok b) := by
  intro b' he
  cases he
  exact h

theorem bind_related {A A' B B' : Type} {RA : A → A' → Prop} {RB : B → B' → Prop}
    {a : A} {m : C A'} {f : A → B} {g : A' → C B'} (hm : CompRel RA a m)
    (hf : ∀ a a', RA a a' → CompRel RB (f a) (g a')) :
    CompRel RB (f a) (m >>= g) := by
  intro b hb
  cases m with
  | error e => cases hb
  | ok a' => exact hf a a' (hm a' rfl) b hb

theorem application_related (hf : ArrowRel RA RB f g) (ha : RA a a') :
    CompRel RB (f a) (g a') := hf a a' ha

abbrev CallbackRel := ArrowRel (Eq : Nat → Nat → Prop) (Eq : Nat → Nat → Prop)

def applyZero (f : Nat → Nat) := f 0
def applyZeroE (f : Nat → C Nat) := f 0

theorem applyZero_related : ArrowRel CallbackRel Eq applyZero applyZeroE := by
  intro f g hf
  show CompRel Eq (f 0) (g 0)
  exact application_related hf (show (0 : Nat) = 0 from rfl)

theorem unequal_callbacks_not_related :
    ¬ CallbackRel (fun _ => 0) (fun _ => .ok 1) := by
  intro h
  exact Nat.noConfusion (h 0 0 rfl 1 rfl)

def twice (f : Nat → Nat) (x : Nat) := f (f x)
def twiceE (f : Nat → C Nat) (x : Nat) : C Nat := f x >>= f

theorem twice_related (hf : CallbackRel f g) :
    CallbackRel (twice f) (twiceE g) := by
  intro x x' hx
  change CompRel Eq (f (f x)) (g x' >>= g)
  exact bind_related (f := f) (hf x x' hx) hf

/- A returned closure itself accepts callbacks. Its relation has no artificial
   observation index, including when used as a field of recursive data. -/
def returnHigher (x : Nat) : (Nat → Nat) → Nat := fun f => twice f x
def returnHigherE (x : Nat) : C ((Nat → C Nat) → C Nat) :=
  .ok (fun f => twiceE f x)

theorem returned_higher_related :
    ArrowRel Eq (ArrowRel CallbackRel Eq) returnHigher returnHigherE := by
  intro x x' hx
  apply pure_related
  intro f g hf
  exact twice_related hf x x' hx

mutual
  inductive RefAction (A : Type) where
    | active : A → RefAction A
    | next : RefND A → RefAction A
  inductive RefND (A : Type) where
    | mk : (Unit → RefAction A) → RefND A
end

mutual
  inductive ExecAction (A : Type) where
    | active : A → ExecAction A
    | next : ExecND A → ExecAction A
  inductive ExecND (A : Type) where
    | mk : (Unit → ExecResult A) → ExecND A
  inductive ExecResult (A : Type) where
    | error : String → ExecResult A
    | ok : ExecAction A → ExecResult A
end

/- An explicit mutual result type avoids Lean 4.32.2's failed autogenerated
   SizeOf specification for Except nested under this recursive function field.
   The forcing interface remains Except; no generation option is disabled. -/
def resultC : ExecResult A → C (ExecAction A)
  | .error e => .error e
  | .ok a => .ok a

def resultND : C (ExecAction A) → ExecResult A
  | .error e => .error e
  | .ok a => .ok a

theorem result_roundtrip (x : C (ExecAction A)) : resultC (resultND x) = x := by
  cases x <;> rfl

theorem result_roundtrip_back (x : ExecResult A) : resultND (resultC x) = x := by
  cases x <;> rfl

/- Mutually inductive relations, with recursive occurrences only in positive
   result positions. Higher-order payload relations are parameters. -/
mutual
  inductive ActionRel (R : A → B → Prop) : RefAction A → ExecAction B → Prop where
    | active : R a b → ActionRel R (.active a) (.active b)
    | next : NDRel R m n → ActionRel R (.next m) (.next n)
  inductive NDRel (R : A → B → Prop) : RefND A → ExecND B → Prop where
    | mk {f : Unit → RefAction A} {g : Unit → ExecResult B} :
        (∀ u v, resultC (g u) = .ok v → ActionRel R (f u) v) →
        NDRel R (.mk f) (.mk g)
end

theorem forcing_related (h : NDRel R (.mk f) (.mk g)) :
    ∀ u, CompRel (ActionRel R) (f u) (resultC (g u)) := by
  cases h with
  | mk h => exact h

def suspend (a : A) : RefND A := .mk (fun _ => .active a)
def suspendE (b : B) : ExecND B := .mk (fun _ => .ok (.active b))

theorem suspend_related (h : R a b) : NDRel R (suspend a) (suspendE b) := by
  apply NDRel.mk
  intro u v hv
  cases hv
  exact .active h

def delay (m : RefND A) : RefND A := .mk (fun _ => .next m)
def delayE (m : ExecND A) : ExecND A := .mk (fun _ => .ok (.next m))

theorem delay_related (h : NDRel R m n) : NDRel R (delay m) (delayE n) := by
  apply NDRel.mk
  intro u v hv
  cases hv
  exact .next h

theorem nd_higher_related :
    NDRel (ArrowRel CallbackRel Eq)
      (delay (suspend (returnHigher 0)))
      (delayE (suspendE (fun f => twiceE f 0))) := by
  apply delay_related
  apply suspend_related
  exact returned_higher_related 0 0 rfl _ rfl

/- Compiler-inserted exhaustion and supply are observable even when a
   computation's returned value is discarded. -/
def loudSpin : Nat → Nat → C Nat
  | 0, _ => .error "exhausted"
  | k + 1, n => if n = 0 then .ok 0 else loudSpin k (n - 1)

theorem discarded_zero_call (n : Nat) :
    (loudSpin 0 n >>= fun _ => .ok 42) = .error "exhausted" := rfl

abbrev SupplyC (A : Type) := Nat → C A × Nat
def supplyBind (m : SupplyC A) (k : A → SupplyC B) : SupplyC B := fun s =>
  match m s with
  | (.error e, t) => (.error e, t)
  | (.ok a, t) => k a t
def tick : SupplyC Nat := fun s => (.ok s, s + 1)
def fail : SupplyC Nat := fun s => (.error "failed", s)

theorem discarded_draw (s : Nat) :
    supplyBind tick (fun _ => tick) s = (.ok (s + 1), s + 2) := rfl

theorem draw_before_error (s : Nat) :
    supplyBind tick (fun _ => supplyBind fail (fun _ => tick)) s =
      (.error "failed", s + 1) := rfl

/- Context-dependent initializers are evaluated once for an explicit
   environment. Accessors project values instead of rerunning computations. -/
structure Context where
  fuel : Nat
  reader : Nat
structure Env where
  spun : Nat
  swPlusOne : Nat

def spin : Nat → Nat → Nat
  | 0, _ => 999
  | k + 1, n => if n = 0 then 0 else spin k (n - 1)

def init (ctx : Context) : C Env := .ok ⟨spin ctx.fuel 7, ctx.reader + 1⟩

theorem init_sufficient : init ⟨100, 5⟩ = .ok ⟨0, 6⟩ := rfl
theorem init_sentinel : init ⟨7, 5⟩ = .ok ⟨999, 6⟩ := rfl

def initChecked (ctx : Context) : C Env := do
  let _ ← loudSpin ctx.fuel 7
  init ctx

theorem init_error_precedes_access :
    (initChecked ⟨0, 5⟩ >>= fun e => .ok (e.swPlusOne, e.swPlusOne)) =
      .error "exhausted" := rfl

