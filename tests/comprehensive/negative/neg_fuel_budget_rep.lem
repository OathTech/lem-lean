(* EXPECT: carries a Lean target_rep *)
(* audit minor-3 (rep leg, auditor shape p8 — incl. reader_consumer
   implementations): a target_rep'd val renders its lem definition as
   a comment; no fuel wrapper is emitted, so the budget would be
   silently inert. *)
open import Pervasives
val spin : nat -> nat
let rec spin n = if n = 0 then 0 else spin (n - 1)
declare lean target_rep function spin = `X.spin`
declare {lean} fuel val spin = `999`
declare {lean} fuel val spin = 5
