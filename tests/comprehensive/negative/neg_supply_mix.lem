(* EXPECT: both {lean} supply and {lean} effectful *)
(* Supply annotation-mix guard (effect-retirement L1, charter §3.2):
   during the transition a val must not carry both the supply and the
   effectful declaration — one mechanism per val. *)
open import Pervasives
val tick : unit -> nat
declare lean target_rep function tick u = 0
declare {lean} effectful val tick
declare {lean} supply val tick
let draws u = tick ()
