open import Pervasives

(* ================================================================
   Per-declaration fuel budgets (effect-retirement arc, charter §8.3):
   the NUMERIC form 'declare {lean} fuel val f = N' sets f's WRAPPER
   budget, replacing lemDefaultFuel for exactly that declaration. The
   worker, the threading, the self-call discipline are unchanged; the
   budget touches one literal in the point-free wrapper.

   HARD CONSTRAINT (consumer-ratified, charter §8.3): OPT-IN ONLY —
   declarations without a budget keep lemDefaultFuel byte-for-byte
   (dspin below pins the unannotated shape; the compiled test
   TestFuelBudgetExec.lean witnesses the exact 10^6 default boundary
   next to the budgeted cut).
   ================================================================ *)

(* budgeted: exhausts at depth 5 *)
val bspin : nat -> nat
let rec bspin n = if n = 0 then 0 else bspin (n - 1)
declare {lean} fuel val bspin = `999`
declare {lean} fuel val bspin = 5

(* unannotated sibling: identical shape, lemDefaultFuel semantics *)
val dspin : nat -> nat
let rec dspin n = if n = 0 then 0 else dspin (n - 1)
declare {lean} fuel val dspin = `999`

(* fuel'd defs are not lifted, so they are assertable directly:
   budget 5 admits depth 4 (5 invocations) and cuts at depth 5 *)
assert fb_within_budget : (bspin 4 = (0:nat))
assert fb_exhausts_at_budget : (bspin 5 = (999:nat))
assert fb_default_sibling : (dspin 100 = (0:nat))

(* budget × reader composition: the wrapper keeps the reader-prefixed
   type; only its budget literal changes (pins in
   TestFuelBudgetExec.lean / TestFuelBudgetCheck section of the exec) *)
val amb : unit -> nat
declare lean target_rep function amb u = 0
declare {lean} reader val amb

val climb : nat -> nat
let rec climb n = if n = amb () then n else climb (n + 1)
declare {lean} fuel val climb = `998`
declare {lean} fuel val climb = 7
