ifdef POLY
HOLHEAP_NAME = lemheap
EXTRA_CLEANS = $(HOLHEAP_NAME) $(HOLHEAP_NAME).o 

BARE_DEPS = lemLib lemTheory lem_pervasivesTheory lem_pervasives_extraTheory lem_stringTheory lem_wordTheory
DEPS = $(patsubst %,%.uo,$(BARE_DEPS))

.PHONY: all
all: $(HOLHEAP_NAME) 

# The command to build heaps has changed after Trindemossen-2 release, so allow
# both for now, and we can drop the first after the next HOL release.
$(HOLHEAP_NAME): $(DEPS)
	rm -f $(HOLHEAP_NAME)
	if type $(protect $(HOLDIR)/bin/buildheap) >/dev/null 2>/dev/null; then \
	  $(protect $(HOLDIR)/bin/buildheap) -o $@ $(BARE_DEPS); else \
	  $(protect $(HOLDIR)/bin/hol) buildheap -o $@ $(BARE_DEPS); fi
endif
